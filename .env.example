# Copy to .env and fill in one provider.

# --- Provider selection ---
# openai | openrouter
# If unset: uses openrouter when OPENROUTER_API_KEY is present, else openai.
# LLM_PROVIDER=openrouter

# --- OpenRouter (recommended for multi-model access) ---
OPENROUTER_API_KEY=sk-or-v1-...
# Examples: openai/gpt-4.1-mini  anthropic/claude-sonnet-4  google/gemini-2.5-flash
MODEL=openai/gpt-4.1-mini

# Optional OpenRouter attribution headers
APP_URL=http://127.0.0.1:5000
APP_NAME=Conspiracy Theory Generator

# --- OpenAI (native Responses API + optional hosted web search) ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# MODEL=gpt-4.1-mini
